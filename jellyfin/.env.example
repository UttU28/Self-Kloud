# Copy to .env after migration (or edit paths manually)
JELLYFIN_UID=1000
JELLYFIN_GID=1000
JELLYFIN_CONFIG_PATH=/home/dedsec995/Desktop/selfHosted/jellyfin/config
MEDIA_PATH=/home/dedsec995/Desktop/selfHosted/jellyfin/media
JELLYFIN_DOMAIN=streaming.thatinsaneguy.com

# NVIDIA NVENC/NVDEC (RTX 3060). Set to "none" to disable GPU in compose.
JELLYFIN_GPU=nvidia

# Image source: custom (uttu28 forks via jellyfin-packaging) or official (Docker Hub).
# To go back to Hub: JELLYFIN_IMAGE_SOURCE=official and JELLYFIN_IMAGE=jellyfin/jellyfin:latest
# Do not point a 12.x custom image at a 10.11 config without a backup.
JELLYFIN_IMAGE_SOURCE=custom
JELLYFIN_IMAGE=jellyfin/jellyfin:hide-items-amd64
# JELLYFIN_IMAGE_SOURCE=official
# JELLYFIN_IMAGE=jellyfin/jellyfin:latest

JELLYFIN_FORK_SERVER=https://github.com/uttu28/jellyfin.git
JELLYFIN_FORK_WEB=https://github.com/uttu28/jellyfin-web.git
JELLYFIN_FORK_BRANCH=feature/hide-items-from-library
# JELLYFIN_PACKAGING_DIR=/home/dedsec995/Desktop/selfHosted/jellyfin-packaging

# Optional Transmission proxy (tracker/web). Run: python3 jellyfin/configureTransmissionProxy.py
# TRANSMISSION_PROXY_URL=socks5h://127.0.0.1:1080

# Dashboard → API Keys. Used by scripts/jellyfinWatchOrder.py
JELLYFIN_API_KEY=API_KEY_HERE
# JELLYFIN_URL=http://127.0.0.1:8096